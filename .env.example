# OpenAid — environment configuration template
# Copy to .env and adjust. NEVER commit real .env files.

# ------------------------------------------------------------------
# Database (PostgreSQL + PostGIS)
# ------------------------------------------------------------------
# Docker Compose (repo root): the API container reaches PostGIS at "db".
OPENAID_DB_HOST=db
OPENAID_DB_PORT=5432
OPENAID_DB_NAME=openaid
OPENAID_DB_USER=openaid
OPENAID_DB_PASSWORD=change_me_locally

# Full URL form (used directly by openaid-core / apps-api).
# Docker Compose default:
DATABASE_URL=postgresql+psycopg://openaid:change_me_locally@db:5432/openaid

# ------------------------------------------------------------------
# API
# ------------------------------------------------------------------
OPENAID_API_HOST=0.0.0.0
OPENAID_API_PORT=8000
OPENAID_API_LOG_LEVEL=info
# Comma-separated origins for CORS ("*" for local development)
OPENAID_CORS_ORIGINS=*

# ------------------------------------------------------------------
# Ingestion limits (safety rails)
# ------------------------------------------------------------------
OPENAID_MAX_UPLOAD_MB=50
OPENAID_MAX_FEATURES=50000
